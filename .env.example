# Resend (https://resend.com) - contact form delivery
RESEND_API_KEY=
# Optional. Defaults to the email in lib/site.ts
CONTACT_TO_EMAIL=
# Optional. Use an address on a domain verified in Resend (e.g. "CULT. tales <hello@culttales.com>").
# Defaults to Resend's onboarding sender, which can only deliver to the Resend account owner's email.
CONTACT_FROM_EMAIL=
