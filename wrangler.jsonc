{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "culttales",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "culttales"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Plain (non-secret) settings for the contact form. Secrets such as
  // RESEND_API_KEY and SUPABASE_SECRET_KEY stay in the dashboard.
  "vars": {
    "CONTACT_FROM_EMAIL": "CULT. tales <enquiries@culttales.com>",
    "SUPABASE_URL": "https://yfptwzzyagykxmydwimc.supabase.co"
  },
  // Keep any other variables added in the dashboard when deploying.
  "keep_vars": true,
  // Up to 5 contact form posts a minute from one IP (app/api/contact/route.ts).
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Workers Logs, so contact form failures can be found in the dashboard.
  "observability": {
    "enabled": true
  }
}
