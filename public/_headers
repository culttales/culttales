/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Photos and films keep their names when replaced, so cache for a day and
# refresh in the background for a week rather than forever.
/images/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800

/videos/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800

/logo/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800

# Pages get their security headers from next.config.mjs; these cover files.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
