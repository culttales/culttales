# Resend (https://resend.com) - contact form delivery
RESEND_API_KEY=
# Optional. Defaults to the email in lib/site.ts
CONTACT_TO_EMAIL=
# Optional. Use an address on a domain verified in Resend (e.g. "CULT. tales <hello@culttales.com>").
# Defaults to Resend's onboarding sender, which can only deliver to the Resend account owner's email.
CONTACT_FROM_EMAIL=

# Supabase (https://supabase.com) - every enquiry is also saved to the "enquiries" table.
# Project "culttales's Project" (culttales Supabase account). Table schema: supabase/migrations.
SUPABASE_URL=https://dlkbxqaqvesbelaryitb.supabase.co
# Secret key (sb_secret_...) from Project Settings → API Keys. Server only; never commit it.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (optional bot check on the enquiry form). Both unset = off.
# Site key is a build variable (inlined into the page); secret key is a Worker secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
